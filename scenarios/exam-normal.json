{
  "protocol": { "scenario": "1.0" },
  "id": "exam-normal",
  "name": "正常预约座位",
  "description": "单个新用户预约有座位的考试（exam-1，容量 2）：holder 先显式预约占用 1 个座位（内核不向适配器传角色种子，占用意图由 seedRole 声明 + 显式预约步骤保证，规则 7），alice 随后预约成功，reservations 恰好 2 条、剩余座位归 0。正确实现退出码 0。",
  "app": "exam-seat-app",
  "seed": 17,
  "roles": [
    { "id": "alice", "account": { "username": "alice_rc", "password": "pw-alice" }, "seedRole": "none" },
    { "id": "holder", "account": { "username": "holder_rc", "password": "pw-holder" }, "seedRole": "holder" }
  ],
  "steps": [
    { "id": "holder-register", "actor": "holder", "op": "register", "params": { "username": "holder_rc", "password": "pw-holder" } },
    { "id": "holder-login", "actor": "holder", "op": "login", "params": { "username": "holder_rc", "password": "pw-holder" } },
    { "id": "holder-nav-reserve", "actor": "holder", "op": "navigate", "params": { "path": "/reserve?exam=exam-1" } },
    { "id": "holder-submit-reserve", "actor": "holder", "op": "submit" },
    { "id": "alice-register", "actor": "alice", "op": "register", "params": { "username": "alice_rc", "password": "pw-alice" } },
    { "id": "alice-login", "actor": "alice", "op": "login", "params": { "username": "alice_rc", "password": "pw-alice" } },
    { "id": "alice-nav-reserve", "actor": "alice", "op": "navigate", "params": { "path": "/reserve?exam=exam-1" } },
    { "id": "alice-submit-reserve", "actor": "alice", "op": "submit" }
  ],
  "observers": [
    {
      "id": "seat-count",
      "sql": "SELECT COUNT(*) AS n FROM reservations",
      "tables": ["reservations"],
      "expectColumns": ["n"]
    },
    {
      "id": "seats-left",
      "sql": "SELECT capacity - (SELECT COUNT(*) FROM reservations WHERE reservations.exam_id = exams.id) AS left FROM exams WHERE id = 'exam-1'",
      "tables": ["exams", "reservations"],
      "expectColumns": ["left"]
    }
  ],
  "assertions": [
    { "id": "alice-reservation-recorded", "rule": "reservation-recorded", "observer": "seat-count", "op": "eq", "value": 2 },
    { "id": "seats-non-negative", "rule": "capacity-not-exceeded", "observer": "seats-left", "op": "gte", "value": 0 }
  ],
  "rules": [
    { "id": "reservation-recorded", "description": "预约落库：reservations 恰好 2 条（holder 先行占用 + alice 本次预约）" },
    { "id": "capacity-not-exceeded", "description": "座位守恒：seats-left >= 0，预约后剩余座位归 0 但不为负" }
  ]
}
