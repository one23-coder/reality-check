{
  "protocol": { "scenario": "1.1" },
  "id": "booking-normal",
  "name": "正常报名",
  "description": "单个新用户报名有名额课程：holder 以 seedRole:\"holder\" 声明占用 1 个初始名额，内核在启动环境时把角色声明交给适配器落库（规则 7），alice 随后报名成功，bookings 恰好 2 条、剩余名额归 0。正确实现退出码 0。",
  "app": "booking-app",
  "seed": 7,
  "roles": [
    { "id": "alice", "account": { "username": "alice_rc", "password": "pw-alice" }, "seedRole": "none" },
    { "id": "holder", "account": { "username": "holder_rc", "password": "pw-holder" }, "seedRole": "holder" }
  ],
  "steps": [
    { "id": "alice-register", "actor": "alice", "op": "register", "params": { "username": "alice_rc", "password": "pw-alice" } },
    { "id": "alice-login", "actor": "alice", "op": "login", "params": { "username": "alice_rc", "password": "pw-alice" } },
    { "id": "alice-nav-book", "actor": "alice", "op": "navigate", "params": { "path": "/book?course=course-1" } },
    { "id": "alice-submit-booking", "actor": "alice", "op": "submit" }
  ],
  "observers": [
    {
      "id": "booking-count",
      "sql": "SELECT COUNT(*) AS n FROM bookings",
      "tables": ["bookings"],
      "expectColumns": ["n"]
    },
    {
      "id": "capacity-left",
      "sql": "SELECT capacity - (SELECT COUNT(*) FROM bookings WHERE bookings.course_id = courses.id) AS left FROM courses WHERE id = 'course-1'",
      "tables": ["courses", "bookings"],
      "expectColumns": ["left"]
    }
  ],
  "assertions": [
    { "id": "alice-booking-recorded", "rule": "booking-recorded", "observer": "booking-count", "op": "eq", "value": 2 },
    { "id": "capacity-non-negative", "rule": "capacity-not-exceeded", "observer": "capacity-left", "op": "gte", "value": 0 }
  ],
  "rules": [
    { "id": "booking-recorded", "description": "报名落库：bookings 恰好 2 条（holder 先行占用 + alice 本次报名）" },
    { "id": "capacity-not-exceeded", "description": "名额守恒：capacity-left >= 0，报名后剩余名额归 0 但不为负" }
  ]
}
