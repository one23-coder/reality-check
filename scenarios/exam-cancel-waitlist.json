{
  "protocol": {
    "scenario": "1.0"
  },
  "id": "exam-cancel-waitlist",
  "name": "取消候补递补",
  "description": "两个 holder 以 seedRole:\"holder\" 声明占用全部座位（exam-1 容量 2，内核在启动环境时把角色声明交给适配器落库，规则 7），bob、carol 相继预约时座位已满、按序进入候补队列（bob 位1、carol 位2），随后 holder 取消预约。正确实现按候补队列声明顺序递补队首：reservations 保持满员 2 条、seats-left 回到 0、队首 bob_rc 获得递补名额。cancel-keeps-seat 故障只删预约不递补（reservations=1、seats-left=1）→ cancel-releases-seat 违规、递补顺序无从观察而降级 inconclusive；waitlist-order-wrong 故障递补队尾 carol_rc → 由 reservation-holder 的 eqStr 断言检出。",
  "app": "exam-seat-app",
  "seed": 23,
  "roles": [
    {
      "id": "holder",
      "account": {
        "username": "holder_rc",
        "password": "pw-holder"
      },
      "seedRole": "holder"
    },
    {
      "id": "holder2",
      "account": {
        "username": "holder2_rc",
        "password": "pw-holder2"
      },
      "seedRole": "holder"
    },
    {
      "id": "bob",
      "account": {
        "username": "bob_rc",
        "password": "pw-bob"
      },
      "seedRole": "none"
    },
    {
      "id": "carol",
      "account": {
        "username": "carol_rc",
        "password": "pw-carol"
      },
      "seedRole": "none"
    }
  ],
  "steps": [
    {
      "id": "bob-register",
      "actor": "bob",
      "op": "register",
      "params": {
        "username": "bob_rc",
        "password": "pw-bob"
      }
    },
    {
      "id": "bob-login",
      "actor": "bob",
      "op": "login",
      "params": {
        "username": "bob_rc",
        "password": "pw-bob"
      }
    },
    {
      "id": "bob-nav-reserve",
      "actor": "bob",
      "op": "navigate",
      "params": {
        "path": "/reserve?exam=exam-1"
      }
    },
    {
      "id": "bob-submit-reserve",
      "actor": "bob",
      "op": "submit"
    },
    {
      "id": "carol-register",
      "actor": "carol",
      "op": "register",
      "params": {
        "username": "carol_rc",
        "password": "pw-carol"
      }
    },
    {
      "id": "carol-login",
      "actor": "carol",
      "op": "login",
      "params": {
        "username": "carol_rc",
        "password": "pw-carol"
      }
    },
    {
      "id": "carol-nav-reserve",
      "actor": "carol",
      "op": "navigate",
      "params": {
        "path": "/reserve?exam=exam-1"
      }
    },
    {
      "id": "carol-submit-reserve",
      "actor": "carol",
      "op": "submit"
    },
    {
      "id": "holder-login",
      "actor": "holder",
      "op": "login",
      "params": {
        "username": "holder_rc",
        "password": "pw-holder"
      }
    },
    {
      "id": "holder-nav-cancel",
      "actor": "holder",
      "op": "navigate",
      "params": {
        "path": "/cancel?exam=exam-1"
      },
      "retry": { "attempts": 2, "on": ["error"] }
    },
    {
      "id": "holder-submit-cancel",
      "actor": "holder",
      "op": "submit",
      "retry": { "attempts": 2, "on": ["error"] }
    }
  ],
  "observers": [
    {
      "id": "seat-count",
      "sql": "SELECT COUNT(*) AS n FROM reservations",
      "tables": [
        "reservations"
      ],
      "expectColumns": [
        "n"
      ]
    },
    {
      "id": "seats-left",
      "sql": "SELECT capacity - (SELECT COUNT(*) FROM reservations WHERE reservations.exam_id = exams.id) AS left FROM exams WHERE id = 'exam-1'",
      "tables": [
        "exams",
        "reservations"
      ],
      "expectColumns": [
        "left"
      ]
    },
    {
      "id": "reservation-holder",
      "sql": "SELECT account FROM reservations WHERE exam_id = 'exam-1' AND account NOT IN ('holder_rc','holder2_rc') ORDER BY id ASC LIMIT 1",
      "tables": [
        "reservations"
      ],
      "expectColumns": [
        "account"
      ]
    }
  ],
  "assertions": [
    {
      "id": "seat-refilled-by-promotion",
      "rule": "cancel-releases-seat",
      "observer": "seat-count",
      "op": "eq",
      "value": 2
    },
    {
      "id": "seats-back-to-full",
      "rule": "waitlist-declared-order",
      "observer": "seats-left",
      "op": "lte",
      "value": 0
    },
    {
      "id": "promotion-respects-declared-order",
      "rule": "waitlist-declared-order",
      "observer": "reservation-holder",
      "op": "eqStr",
      "expected": "bob_rc"
    }
  ],
  "rules": [
    {
      "id": "cancel-releases-seat",
      "description": "取消释放的座位被候补递补回填：reservations 保持容量 2（holder 取消 + 队首递补）；cancel-keeps-seat 故障只删不补使 reservations 掉到 1"
    },
    {
      "id": "waitlist-declared-order",
      "description": "递补按声明的候补队列顺序完成：队首 bob_rc 获得递补名额（reservation-holder eqStr bob_rc）。waitlist-order-wrong 递补队尾 carol_rc 时违规；cancel-keeps-seat 无递补时违规。"
    }
  ]
}
