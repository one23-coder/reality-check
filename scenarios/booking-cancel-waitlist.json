{
  "protocol": {
    "scenario": "1.0"
  },
  "id": "booking-cancel-waitlist",
  "name": "取消候补递补",
  "description": "两个 holder 以 seedRole:\"holder\" 声明占用全部名额（内核在启动环境时把角色声明交给适配器落库，规则 7），bob、carol 相继报名时课程已满、按序进入候补队列（bob 位1、carol 位2），随后 holder 取消报名。正确实现按队列声明顺序递补队首 bob_rc；waitlist-order-wrong 递补队尾 carol_rc、cancel-keeps-slot 不递补，均由 booking-holder 的 eqStr 断言检出。",
  "app": "booking-app",
  "seed": 13,
  "roles": [
    {
      "id": "holder",
      "account": {
        "username": "holder_rc",
        "password": "pw-holder"
      },
      "seedRole": "holder"
    },
    {
      "id": "holder2",
      "account": {
        "username": "holder2_rc",
        "password": "pw-holder2"
      },
      "seedRole": "holder"
    },
    {
      "id": "bob",
      "account": {
        "username": "bob_rc",
        "password": "pw-bob"
      },
      "seedRole": "none"
    },
    {
      "id": "carol",
      "account": {
        "username": "carol_rc",
        "password": "pw-carol"
      },
      "seedRole": "none"
    }
  ],
  "steps": [
    {
      "id": "bob-register",
      "actor": "bob",
      "op": "register",
      "params": {
        "username": "bob_rc",
        "password": "pw-bob"
      }
    },
    {
      "id": "bob-login",
      "actor": "bob",
      "op": "login",
      "params": {
        "username": "bob_rc",
        "password": "pw-bob"
      }
    },
    {
      "id": "bob-nav-book",
      "actor": "bob",
      "op": "navigate",
      "params": {
        "path": "/book?course=course-1"
      }
    },
    {
      "id": "bob-submit-booking",
      "actor": "bob",
      "op": "submit"
    },
    {
      "id": "carol-register",
      "actor": "carol",
      "op": "register",
      "params": {
        "username": "carol_rc",
        "password": "pw-carol"
      }
    },
    {
      "id": "carol-login",
      "actor": "carol",
      "op": "login",
      "params": {
        "username": "carol_rc",
        "password": "pw-carol"
      }
    },
    {
      "id": "carol-nav-book",
      "actor": "carol",
      "op": "navigate",
      "params": {
        "path": "/book?course=course-1"
      }
    },
    {
      "id": "carol-submit-booking",
      "actor": "carol",
      "op": "submit"
    },
    {
      "id": "holder-login",
      "actor": "holder",
      "op": "login",
      "params": {
        "username": "holder_rc",
        "password": "pw-holder"
      }
    },
    {
      "id": "holder-nav-cancel",
      "actor": "holder",
      "op": "navigate",
      "params": {
        "path": "/cancel?course=course-1"
      },
      "retry": { "attempts": 2, "on": ["error"] }
    },
    {
      "id": "holder-submit-cancel",
      "actor": "holder",
      "op": "submit",
      "retry": { "attempts": 2, "on": ["error"] }
    }
  ],
  "observers": [
    {
      "id": "booking-count",
      "sql": "SELECT COUNT(*) AS n FROM bookings",
      "tables": [
        "bookings"
      ],
      "expectColumns": [
        "n"
      ]
    },
    {
      "id": "capacity-left",
      "sql": "SELECT capacity - (SELECT COUNT(*) FROM bookings WHERE bookings.course_id = courses.id) AS left FROM courses WHERE id = 'course-1'",
      "tables": [
        "courses",
        "bookings"
      ],
      "expectColumns": [
        "left"
      ]
    },
    {
      "id": "waitlist-head",
      "sql": "SELECT account FROM waitlist WHERE course_id = 'course-1' ORDER BY position ASC LIMIT 1",
      "tables": [
        "waitlist"
      ],
      "expectColumns": [
        "account"
      ]
    },
    {
      "id": "waitlist-order",
      "sql": "SELECT account FROM waitlist WHERE course_id = 'course-1' ORDER BY position ASC",
      "tables": [
        "waitlist"
      ],
      "expectColumns": [
        "account"
      ]
    },
    {
      "id": "booking-holder",
      "sql": "SELECT account FROM bookings WHERE course_id = 'course-1' AND account NOT IN ('holder_rc','holder2_rc') ORDER BY id ASC LIMIT 1",
      "tables": [
        "bookings"
      ],
      "expectColumns": [
        "account"
      ]
    }
  ],
  "assertions": [
    {
      "id": "slot-refilled-by-promotion",
      "rule": "cancel-releases-slot",
      "observer": "booking-count",
      "op": "eq",
      "value": 2
    },
    {
      "id": "promotion-respects-declared-order",
      "rule": "waitlist-declared-order",
      "observer": "booking-holder",
      "op": "eqStr",
      "expected": "bob_rc"
    },
    {
      "id": "queue-drains-in-declared-order",
      "rule": "waitlist-declared-order",
      "observer": "waitlist-head",
      "op": "eqStr",
      "expected": "carol_rc"
    }
  ],
  "rules": [
    {
      "id": "cancel-releases-slot",
      "description": "取消释放的名额被候补递补回填：bookings 保持容量 2（holder 取消 + 队首递补）；cancel-keeps-slot 故障只删不补使 bookings 掉到 1"
    },
    {
      "id": "waitlist-declared-order",
      "description": "递补按声明的候补队列顺序完成：队首 bob_rc 获得递补名额（booking-holder eqStr bob_rc）。waitlist-order-wrong 递补队尾 carol_rc 时违规；cancel-keeps-slot 无递补时违规。"
    }
  ]
}
